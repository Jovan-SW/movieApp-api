# .env.example

# TMDB API base URL (no trailing slash)
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3

# TMDB API Key (v3 auth — kept for reference, not used by apiClient.js)
VITE_TMDB_API_KEY=

# TMDB Read Access Token (v4 Bearer token)
# Get it from: TMDB Account > Settings > API > API Read Access Token (v4 auth)
VITE_TMDB_API_TOKEN=

# Supabase (optional — only if you use Supabase features)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
